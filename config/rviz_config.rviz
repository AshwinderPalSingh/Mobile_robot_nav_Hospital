Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
      Use Timestamp: false

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Alpha: 1.0
      Min Intensity: 0
      Max Intensity: 4096
      Decay Time: 0
      Use Fixed Frame: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Links:
        All Links Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
      TF Prefix: ""

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Arrows: true
      Show Axes: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Frames:
        All Enabled: true
      Update Interval: 0

    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Alpha: 1.0
      Line Style: Lines
      Line Width: 0.03
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Buffer Length: 1

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Alpha: 1.0
      Line Style: Lines
      Line Width: 0.03
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Buffer Length: 1

    - Class: rviz_default_plugins/PoseArray
      Name: AMCL Particles
      Enabled: true
      Topic:
        Value: /particlecloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color: 128; 0; 255
      Arrow Length: 0.1
      Axes Length: 0.3
      Axes Radius: 0.01
      Shape: Arrow (Flat)

    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL Pose
      Enabled: true
      Topic:
        Value: /amcl_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Alpha: 1.0
      Covariance:
        Value: true
        Position:
          Alpha: 0.3
          Color: 255; 255; 127
          Scale: 1
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Offset: 1
      Shape: Arrow
      Shaft Length: 0.3
      Shaft Radius: 0.05
      Head Length: 0.1
      Head Radius: 0.1
      Axes Length: 0.3
      Axes Radius: 0.01

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose

  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      X: 0
      Y: 0
      Scale: 50
      Angle: 0
      Near Clip Distance: 0.01
      Target Frame: map

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1200
  X: 100
  Y: 100
  Views:
    collapsed: false
